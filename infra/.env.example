# Copiar a infra/.env (que NO se versiona) y reemplazar los valores.
# Ningun valor real va en este archivo.

# Postgres local del servicio db (solo desarrollo y pruebas)
POSTGRES_USER=movil
POSTGRES_PASSWORD=cambiar-esta-clave
POSTGRES_DB=movil

# Conexion de la API en marcha (SQLAlchemy async + asyncpg), con el rol api_app (ADR-0005 §1):
# solo INSERT y SELECT sobre bitacora. Su clave es API_APP_CLAVE. En el VPS apunta a Supabase.
DATABASE_URL=postgresql+asyncpg://api_app:<API_APP_CLAVE>@db:5432/movil
# Clave de api_app. Al arrancar, la API (app.migrar) aplica las migraciones y le da login con esta
# clave. NUNCA se versiona.
API_APP_CLAVE=
# Rol dueño de las tablas, solo para migraciones y la carga de usuarios (CONTRATO-HU-07 v2).
# Local: el usuario de POSTGRES_USER. Si falta, se usa DATABASE_URL (que no puede migrar).
# NUNCA se versiona con su clave.
MIGRACION_DATABASE_URL=postgresql+asyncpg://movil:<POSTGRES_PASSWORD>@db:5432/movil

# Dominio que sirve el proxy. localhost = TLS local con la CA interna de Caddy.
DOMINIO=localhost
# Puertos que publica el proxy. Vacios = 80 y 443 (VPS). En un equipo con el 80 ocupado (http.sys
# de Windows) usar valores alternos; la URL local queda https://localhost:8443.
PROXY_PUERTO_HTTP=8080
PROXY_PUERTO_HTTPS=8443

# --- Fuentes (HU-08, ADR-0006, ADR-0014) -----------------------------------------------------
# URL base de los simuladores (red interna). Respaldo de las tres URL por fuente.
SIMULADORES_URL=http://simuladores:8001
# URL de cada fuente. Vacia = usa SIMULADORES_URL. Para reemplazar una fuente (por otra
# implementacion del mismo contrato de contratos/fuentes/), se cambia solo su URL.
FUENTE_PLACAS_URL=
FUENTE_REQUISITORIAS_URL=
FUENTE_GALERIA_URL=
# Timeout de cada llamada a una fuente, en segundos (ADR-0014).
FUENTE_TIMEOUT_S=3

# --- Fotos de la galeria del simulador (ADR-0008) --------------------------------------------
# Llave AES-GCM de 32 bytes en base64. NUNCA se versiona. Generarla con:
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# Vacia = llave aleatoria en memoria (las fotos se vuelven a cifrar en cada arranque).
SIM_FOTOS_LLAVE=
# Carpeta del HOST con las fotos <persona_id>__<n>.<jpg|png>, FUERA del repositorio. Solo la usa
# infra/docker-compose.fotos.yml, que la monta como SIM_FOTOS_DIR (/fotos-origen) del simulador.
SIM_FOTOS_ORIGEN=

# --- Sesion y acceso (HU-01, HU-02, ADR-0003, ADR-0011) --------------------------------------
# Supabase Auth. Local: el servicio auth (GoTrue) del compose. En el VPS: la URL de Auth del
# proyecto Supabase (https://<proyecto>.supabase.co/auth/v1) y su clave publica en AUTH_APIKEY.
AUTH_URL=http://auth:9999
AUTH_APIKEY=
# Secreto JWT de Supabase Auth (>= 32 caracteres). Local lo usa GoTrue y la API para su clave de
# servicio (alta de usuarios). NUNCA se versiona. Generarlo con:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
AUTH_JWT_SECRETO=cambiar-este-secreto-de-al-menos-32-caracteres
# Clave del usuario supabase_auth_admin del Postgres local (solo desarrollo y pruebas).
AUTH_DB_CLAVE=cambiar-esta-clave-auth
# Secreto con que la API firma sus tokens de acceso (>= 32 caracteres). NUNCA se versiona.
JWT_SECRETO=cambiar-este-otro-secreto-de-al-menos-32-caracteres
# Valores PROVISIONALES (ADR-0011, PA #18 y #19). Se cambian aqui, sin tocar codigo.
SESION_INACTIVIDAD_S=600
TOKEN_ACCESO_VIGENCIA_S=900
BLOQUEO_INTENTOS=5
BLOQUEO_DURACION_S=900
# Clave de los usuarios sinteticos agente1, agente2, revisor1, supervisor1 e inactivo1
# (python -m app.cargar_usuarios). NUNCA se versiona. Las pruebas leen esta misma variable.
CLAVE_USUARIOS_PRUEBA=

# --- Consulta de placa (HU-03, ADR-0011) -----------------------------------------------------
# Formato de placa. Valores PROVISIONALES (PA #20, NO VERIFICADO contra la normativa). Se cambian
# aqui, sin tocar codigo; la app los recibe en GET /v1/motivos (formato_placa). Entre comillas
# simples para que docker compose no interprete el $.
PLACA_FORMATO_REGEX='^[A-Z0-9]{3}-[0-9]{3}$'
PLACA_FORMATO_DESCRIPCION='ABC-123 (3 letras o números, guion, 3 números)'

# --- Credencial de administracion de Auth (DESPLIEGUE-01, decision 1) -------------------------
# SOLO para python -m app.cargar_usuarios. La API en marcha nunca la recibe.
# - Local: vacia. La carga firma un token service_role con AUTH_JWT_SECRETO (GoTrue del compose).
# - VPS (Supabase en la nube): la "secret key" del proyecto (sb_secret_...) o, en proyectos con
#   las claves heredadas, la clave service_role. Mejor no guardarla en el .env del VPS: se pide al
#   correr la carga (scripts/desplegar.ps1 -CargarUsuarios). NUNCA se versiona.
AUTH_ADMIN_CLAVE=

# =============================================================================================
# VPS (DESPLIEGUE-01). En el .env del VPS (fuera del repositorio, permisos 600) van SOLO estas
# variables; db y auth locales no existen alli. Se usa con:
#   docker compose -f infra/docker-compose.yml -f infra/docker-compose.vps.yml --env-file infra/.env ...
# Detalle paso a paso: docs/despliegue/MANUAL-DESPLIEGUE.md
#
#   DOMINIO                  subdominio real (Caddy pide el certificado a Let's Encrypt)
#   (sin PROXY_PUERTO_HTTP ni PROXY_PUERTO_HTTPS: el proxy publica 80 y 443)
#   DATABASE_URL             Session pooler de Supabase con api_app:
#                            postgresql+asyncpg://api_app.<ref-proyecto>:<API_APP_CLAVE>@<host-pooler>:5432/postgres
#   API_APP_CLAVE            clave de api_app (la fija app.migrar)
#   MIGRACION_DATABASE_URL   Session pooler con el rol dueño:
#                            postgresql+asyncpg://postgres.<ref-proyecto>:<clave-de-la-base>@<host-pooler>:5432/postgres
#   AUTH_URL                 https://<ref-proyecto>.supabase.co/auth/v1
#   AUTH_APIKEY              clave publica del proyecto (publishable o anon)
#   AUTH_ADMIN_CLAVE         (opcional en el .env; ver arriba)
#   JWT_SECRETO              secreto propio de la API (>= 32 caracteres)
#   CLAVE_USUARIOS_PRUEBA    clave de los usuarios sinteticos
#   SIM_FOTOS_LLAVE          llave AES-GCM del simulador (aunque no haya fotos hasta HU-05)
#   SESION_INACTIVIDAD_S, TOKEN_ACCESO_VIGENCIA_S, BLOQUEO_INTENTOS, BLOQUEO_DURACION_S,
#   FUENTE_TIMEOUT_S, PLACA_FORMATO_REGEX, PLACA_FORMATO_DESCRIPCION   (como en local)
# No van en el VPS: POSTGRES_*, AUTH_DB_CLAVE, AUTH_JWT_SECRETO, SIM_FOTOS_ORIGEN.
# =============================================================================================
